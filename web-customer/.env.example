# Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only checkout configuration (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Topship / Terminal Shipping API (server-only)
TOPSHIP_SECRET_KEY=your_terminal_secret_key
TOPSHIP_PICKUP_FIRST_NAME=El
TOPSHIP_PICKUP_LAST_NAME=Shalom
TOPSHIP_PICKUP_EMAIL=dispatch@example.com
TOPSHIP_PICKUP_PHONE=+2348000000000
TOPSHIP_PICKUP_ADDRESS=Your dispatch address
TOPSHIP_PICKUP_ADDRESS_LINE2=Nearest landmark, suite, or building details
TOPSHIP_PICKUP_CITY=Lagos
TOPSHIP_PICKUP_STATE=Lagos
TOPSHIP_PICKUP_COUNTRY=NG
TOPSHIP_PICKUP_ZIP=100001
# The catalogue does not currently store product weights. This is used per item
# until individual product weights are added.
TOPSHIP_DEFAULT_ITEM_WEIGHT_KG=0.5
# Required by Topship for persisted Nigerian delivery quotes.
TOPSHIP_DELIVERY_ZIP=100001

# Canonical customer URL used for payment callbacks
NEXT_PUBLIC_SITE_URL=https://elshalomstores.com.ng
